---
// Схожі роботи — тепер чисто відображення.
// Весь підрахунок (граф перелінковки) відбувається один раз на білд
// у src/utils/similarWorksGraph.ts, викликається з [slug].astro
// і передається сюди вже готовими списками.
import type { CollectionEntry } from 'astro:content';
import { TYPE_LABELS, TAG_LABELS } from '../data/tags-registry';

type Work = CollectionEntry<'vykonani-roboty'>;

interface Props {
  relatedTop: Work[];   // Ряд 1 — реально схожі роботи
  moreWorks:  Work[];   // Ряд 2 — інші роботи (з захистом від сиріт)
  currentTypeLabel?: string;
}
const { relatedTop, moreWorks, currentTypeLabel } = Astro.props;

const hasRow1 = relatedTop.length > 0;
const hasRow2 = moreWorks.length > 0;
---

<div class="em-section-alt">
  <div class="em-section-alt-inner">

    {hasRow1 && (
      <>
        <span class="em-section-label">Схожі проєкти</span>
        <h2>Інші роботи{currentTypeLabel ? ` — ${currentTypeLabel}` : ''}</h2>

        <div class="em-similar-grid">
          {relatedTop.map((work) => (
            <a href={`/vykonani-roboty/${work.slug}/`} class="em-work-card">
              <div class="em-work-card-photo">
                <img
                  src={work.data.photos[0].src}
                  alt={work.data.photos[0].caption}
                  loading="lazy"
                />
              </div>
              <div class="em-work-card-body">
                <div class="em-work-card-tags">
                  {work.data.types.map((t: string) => (
                    <span class="em-work-tag em-work-tag--type">
                      {TYPE_LABELS[t] ?? t}
                    </span>
                  ))}
                  {work.data.tags.map((t: string) => (
                    <span class="em-work-tag em-work-tag--tag">
                      {TAG_LABELS[t] ?? t}
                    </span>
                  ))}
                </div>
                <div class="em-work-card-title">{work.data.title}</div>
                <div class="em-work-card-brands">
                  {work.data.brands.join(' · ')}
                </div>
                <span class="em-work-card-btn">Детальніше →</span>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {hasRow2 && (
      <>
        <span class="em-section-label em-section-label--sub">Також можуть зацікавити</span>
        <h3 class="em-more-works-title">Інші наші роботи</h3>

        <div class="em-more-works-grid">
          {moreWorks.map((work) => (
            <a href={`/vykonani-roboty/${work.slug}/`} class="em-more-work-card">
              <span class="em-more-work-type">{TYPE_LABELS[work.data.types[0]] ?? work.data.types[0]}</span>
              <span class="em-more-work-title">{work.data.title}</span>
              <span class="em-more-work-arrow">→</span>
            </a>
          ))}
        </div>
      </>
    )}

    {!hasRow1 && !hasRow2 && (
      <div class="em-similar-empty">
        <p>Переглянути всі наші роботи в каталозі</p>
        <a href="/vykonani-roboty/" class="em-btn-primary">
          Всі виконані роботи →
        </a>
      </div>
    )}

  </div>
</div>

<style>
.em-similar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 8px;
}
@media (max-width: 900px) {
  .em-similar-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .em-similar-grid { grid-template-columns: 1fr; }
}

/* Картка роботи — Ряд 1 (повний формат) */
.em-work-card {
  background: #fff;
  border: 1.5px solid var(--c-accent-border);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
}
.em-work-card:hover {
  border-color: var(--c-accent);
  transform: translateY(-3px);
  box-shadow: var(--shadow-card);
}
.em-work-card-photo {
  aspect-ratio: 4 / 3;
  background: var(--c-bg2);
  overflow: hidden;
}
.em-work-card-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition);
}
.em-work-card:hover .em-work-card-photo img { transform: scale(1.04); }
.em-work-card-body {
  padding: 14px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.em-work-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.em-work-card-title {
  font-family: var(--ff);
  font-weight: 700;
  font-size: 14px;
  color: var(--c-head);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.em-work-card-brands {
  font-size: 11px;
  color: var(--c-muted);
  font-weight: 600;
  margin-top: auto;
}
.em-work-card-btn {
  display: block;
  background: var(--c-accent);
  color: #fff;
  border-radius: var(--radius-sm);
  padding: 9px 16px;
  font-size: 13px;
  font-weight: 600;
  font-family: var(--ff-body);
  text-align: center;
  margin-top: 8px;
  transition: background var(--transition);
}
.em-work-card:hover .em-work-card-btn { background: var(--c-accent-hover); }

/* Ряд 2 — компактні картки «Інші наші роботи» */
.em-section-label--sub {
  margin-top: 28px;
  display: inline-block;
}
.em-more-works-title {
  font-family: var(--ff);
  font-weight: 700;
  font-size: 20px;
  color: var(--c-head);
  margin: 4px 0 16px;
}
.em-more-works-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
@media (max-width: 900px) {
  .em-more-works-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .em-more-works-grid { grid-template-columns: 1fr; }
}
.em-more-work-card {
  background: #fff;
  border: 1.5px solid var(--c-accent-border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-decoration: none;
  transition: border-color var(--transition), transform var(--transition);
}
.em-more-work-card:hover {
  border-color: var(--c-accent);
  transform: translateY(-2px);
}
.em-more-work-type {
  font-size: 11px;
  font-weight: 700;
  color: var(--c-accent);
  text-transform: uppercase;
  letter-spacing: 0.02em;
}
.em-more-work-title {
  font-family: var(--ff-body);
  font-weight: 600;
  font-size: 13px;
  color: var(--c-head);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.em-more-work-arrow {
  font-size: 13px;
  color: var(--c-muted);
  margin-top: auto;
}

/* Кнопка якщо взагалі нема жодних рекомендацій (теоретичний edge-case) */
.em-similar-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
}
.em-similar-empty p {
  font-family: var(--ff-body);
  font-size: 15px;
  color: var(--c-muted);
}
</style>
