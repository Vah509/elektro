---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_CANONICAL } from '../../../config';

const page = {
  lang:        'ru' as const,
  altUrl:      '/vykonani-roboty/',
  section:     'vykonani-roboty',
  title:       'Выполненные работы — электрощиты на заказ | elektroschit.com.ua',
  description: 'Раздел «Выполненные работы» доступен только на украинском языке. Фото щитов управления и силовых щитов от elektroschit.com.ua.',
  canonical:   `${SITE_CANONICAL}/ru/vykonani-roboty/`,
  crumbs: [
    { label: 'Главная',            href: '/ru/' },
    { label: 'Выполненные работы' },
  ],
};
---
<BaseLayout {page}>
  <link slot="head" rel="stylesheet" href="/css/main.css" />

  <div class="em-not-translated">
    <div class="em-not-translated-inner">
      <div class="em-not-translated-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v4M12 16h.01"/>
        </svg>
      </div>
      <h1 class="em-not-translated-title">Раздел недоступен на русском языке</h1>
      <p class="em-not-translated-text">
        Раздел «Выполненные работы» с фотографиями наших электрощитов
        доступен только на украинском языке.
      </p>
      <a href="/vykonani-roboty/" class="em-btn-primary em-not-translated-btn">
        Перейти на украинскую версию →
      </a>
    </div>
  </div>

  <style>
    .em-not-translated {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 24px;
    }
    .em-not-translated-inner {
      max-width: 520px;
      text-align: center;
    }
    .em-not-translated-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      color: var(--c-green, #1e6b3c);
    }
    .em-not-translated-icon svg {
      width: 100%;
      height: 100%;
    }
    .em-not-translated-title {
      font-family: var(--ff);
      font-size: clamp(20px, 3vw, 28px);
      font-weight: 700;
      color: var(--c-head);
      margin: 0 0 16px;
      line-height: 1.2;
    }
    .em-not-translated-text {
      font-size: 16px;
      color: var(--c-text);
      line-height: 1.6;
      margin: 0 0 32px;
    }
    .em-not-translated-btn {
      display: inline-block;
    }
  </style>

  <script is:inline src="/js/em-site.js"></script>
</BaseLayout>
